}, "message": "OK", "failures": null, "unique_id": "model.qafila_margin.stg_supplier_prices", "compiled": true, "compiled_code": "-- Grain: one row per row of every supplier file.\n-- The cost is unit_cost, or cost_sar from week 39 on. Arabic-Indic digits (\u0660-\u0669), the Arabic\n-- decimal separator (\u066b) and decimal commas are normalised to a plain decimal number.\nwith base as (\n    select\n        source_file,\n        trim(sku) as sku,\n        try_cast(valid_from as date) as valid_from,\n        coalesce(unit_cost, cost_sar) as raw_cost\n    from \"qafila\".\"raw\".\"supplier_prices\"\n)\n\nselect\n    *,\n    try_cast(\n        translate(trim(raw_cost), '\u0660\u0661\u0662\u0663\u0664\u0665\u0666\u0667\u0668\u0669\u066b,', '0123456789..') as double\n    ) as parsed_cost\nfrom base", "relation_name": "\"qafila\".\"staging\".\"stg_supplier_prices\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-21T20:56:24.935825Z", "completed_at": "2026-10-21T20:56:24.974345Z"}, {"name": "execute", "started_at": "2026-10-21T20:56:24.982035Z", "completed_at": "2026-10-21T20:56:25.149249Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.23068523406982422, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.qafila_margin.not_null_stg_products_product_id.6373b0acf3", "compiled": true, "compiled_code": "\n    \n    \n\n\n\nselect product_id\nfrom \"qafila\".\"staging\".\"stg_products\"\nwhere product_id is null\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-21T20:56:25.019751Z", "completed_at": "2026-10-21T20:56:25.094603Z"}, {"name": "execute", "started_at": "2026-10-21T20:56:25.097844Z", "completed_at": "2026-10-21T20:56:25.190386Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.2245943546295166, "adapter_response": {"_message": "OK"