roducts\") as pr on pr.sku = p.sku", "relation_name": "\"qafila\".\"silver\".\"supplier_prices_checked\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-21T20:56:25.561633Z", "completed_at": "2026-10-21T20:56:25.584845Z"}, {"name": "execute", "started_at": "2026-10-21T20:56:25.584845Z", "completed_at": "2026-10-21T20:56:25.605936Z"}], "thread_id": "Thread-2 (worker)", "execution_time": 0.04430341720581055, "adapter_response": {"_message": "OK"}, "message": null, "failures": 0, "unique_id": "test.qafila_margin.accepted_values_supplier_prices_checked_reason__True__unknown_sku__invalid_cost.660c1f1fa8", "compiled": true, "compiled_code": "\n    \n    \n\nwith all_values as (\n\n    select\n        reason as value_field,\n        count(*) as n_records\n\n    from \"qafila\".\"silver\".\"supplier_prices_checked\"\n    group by reason\n\n)\n\nselect *\nfrom all_values\nwhere value_field not in (\n    'unknown_sku','invalid_cost'\n)\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-21T20:56:25.623976Z", "completed_at": "2026-10-21T20:56:25.639703Z"}, {"name": "execute", "started_at": "2026-10-21T20:56:25.648580Z", "completed_at": "2026-10-21T20:56:25.779551Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.16290903091430664, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.qafila_margin.price_quarantine", "compiled": true, "compiled_code": "-- Grain: one row per rejected supplier row.\nselect source_file, sku, valid_from, raw_cost, reason\nfrom \"qafila\".\"silver\".\"supplier_prices_checked\"\nwhere reason is not null", "relation_name": "\"qafila\".\"quality\".\"price_quarantine\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-21T20:56:25.623976Z", "completed_at": "2026-10-21T20:56:25.634097Z"}, {"name": "execute", "started_at": "2026-10-21T20:56:25.639703Z", "completed_at": "2026-10-21T20:56:25.791763Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.17512106895446777, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.qafila_margin.product_cost_history", "compiled": true, "compiled_code": "-- Grain: one row per SKU per cost version (SCD2).\nwith usable as (\n    select * from \"qafila\".\"silver\".\"supplier_prices_checked\" where reason is null\n),\n\n-- Same SKU and valid_from in several files: the file whose name sorts last wins (a _fix file).\ndeduplicated as (\n    select sku, valid_from, unit_cost_sar\n    from usable\n    qualify row_number() over (partition by sku, valid_from order by source_file desc) = 1\n),\n\n-- A SKU missing from a weekly file simply has no row, so it keeps its cost.\n-- A new version starts only when the cost differs from the one before.\nchanges as (\n    select\n        *,\n        lag(unit_cost_sar) over (partition by sku order by valid_from) as previous_cost\n    from deduplicated\n),\n\nversions as (\n    select sku, unit_cost_sar, valid_from\n    from changes\n    where previous_cost is null or unit_cost_sar <> previous_cost\n)\n\nselect\n    sku,\n    unit_cost_sar,\n    valid_from,\n    lead(valid_from) over (partition by sku order by valid_from) as valid_to,\n    lead(valid_from) over (partition by sku order by valid_from) is null as is_current\nfrom versions", "relation_name": "\"qafila\".\"silver\".\"product_cost_history\"", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-10-21T20:56:25.841886Z", "completed_at": "2026-10-21T20:56:25.903894Z"}, {"name": "execute", "started_at": "2026-10-21T20:56:25.906027Z", "completed_at": "2026-10-21T20:56:26.010165Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.23402118682861328, "adapter_response": {"_mes